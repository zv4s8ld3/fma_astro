---
import Layout from '../layouts/Layout.astro';
import { normalizedCastsData } from '../data/models_data.js';
---

<Layout 
  title="ARTIST | Fairy Models Agency"
  description="Fairy Models Agency所属のアーティスト・クリエイター一覧。ヘアメイク、スタイリスト、フォトグラファー等の詳細プロフィール・ポートフォリオをご覧いただけます。"
>

    <main class="max-w-[1400px] mx-auto px-4 pt-16 pb-24 w-full flex-grow">
        
        <!-- タイトルエリア -->
        <div class="text-center mb-12">
            <h1 class="font-serif text-3xl tracking-[0.2em] text-[#d7be53] uppercase font-light">ARTIST</h1>
            <p class="text-[10px] tracking-widest text-gray-400 mt-3 uppercase">所属アーティスト</p>
            <div class="w-28 h-[1px] bg-[#d7be53]/30 mx-auto mt-4"></div>
        </div>

        <!-- カテゴリフィルターボタン一覧 (ALL / WOMAN / MAN / ARTIST / DIRECT BOOKING) -->
        <div class="flex flex-wrap justify-center items-center gap-3 sm:gap-4 mb-16 text-xs tracking-[0.2em] uppercase font-medium">
            <a href="/models_all" class="px-5 py-2 border border-[#d7be53]/30 text-[#d7be53] hover:border-[#d7be53] hover:bg-[#d7be53]/10 transition-all rounded">ALL</a>
            <a href="/#models-woman" class="px-5 py-2 border border-[#d7be53]/30 text-[#d7be53] hover:border-[#d7be53] hover:bg-[#d7be53]/10 transition-all rounded">WOMAN</a>
            <a href="/#models-man" class="px-5 py-2 border border-[#d7be53]/30 text-[#d7be53] hover:border-[#d7be53] hover:bg-[#d7be53]/10 transition-all rounded">MAN</a>
            <a href="/artist" class="px-5 py-2 border border-[#d7be53] bg-[#d7be53] text-[#1C110C] font-semibold transition-all rounded shadow-md">ARTIST</a>
            <a href="/direct_booking" class="px-5 py-2 border border-[#d7be53]/30 text-[#d7be53] hover:border-[#d7be53] hover:bg-[#d7be53]/10 transition-all rounded">DIRECT BOOKING</a>
        </div>

        <!-- 1段目: WOMAN ARTIST セクション -->
        <div id="artist-woman" class="mb-16">
            <div class="mb-8 border-b border-white/5 pb-2">
                <h3 class="font-serif text-lg tracking-[0.2em] text-[#d7be53] uppercase font-light">WOMAN</h3>
            </div>
            <div id="artist-woman-grid" class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8"></div>
        </div>

        <!-- 2段目: MAN ARTIST セクション -->
        <div id="artist-man" class="mb-16">
            <div class="mb-8 border-b border-white/5 pb-2">
                <h3 class="font-serif text-lg tracking-[0.2em] text-[#d7be53] uppercase font-light">MAN</h3>
            </div>
            <div id="artist-man-grid" class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8"></div>
        </div>

        <div class="text-center mt-16">
            <a href="/" class="text-xs tracking-widest text-gray-400 hover:text-[#d7be53] transition-colors inline-flex items-center gap-2 font-medium">
                <svg class="w-3 h-3" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M10 19l-7-7m0 0l7-7m-7 7h18"></path></svg>
                BACK TO TOP
            </a>
        </div>

    </main>

    <!-- SECTION: CONTACT -->
    <section id="contact" class="py-24 bg-[#2A1A14] border-t border-white/5 text-[#DDCB82]">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12">
                <div>
                    <h2 class="font-serif text-3xl text-[#d7be53] mb-8 tracking-[0.15em]">CONTACT</h2>
                    <div class="space-y-4 font-light text-sm tracking-wide text-[#DDCB82]/90">
                        <p class="text-base text-[#d7be53] font-serif">
                            <span class="font-semibold">Fairy Models</span> <span class="font-light">Agency</span>
                        </p>
                        <p class="text-gray-400">Operating by ShopKloset inc.</p>
                        <p class="text-gray-400">MAIL: info@fairymodelsagency.com</p>
                    </div>
                </div>
                
                <div class="flex flex-col justify-center space-y-6">
                    <p class="text-xs text-gray-400 font-light tracking-widest leading-relaxed">
                        出演・キャスティングのご依頼、各種お問い合わせ、エントリーは下記専用フォームより承っております。
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <a href="/contact" class="group block bg-[#d7be53] text-[#1C110C] py-4 text-center rounded transition-all duration-300 hover:bg-[#DDCB82] shadow-lg">
                            <span class="block text-[10px] tracking-[0.15em] font-medium opacity-60 mb-0.5">お問い合わせ</span>
                            <span class="block text-xs tracking-[0.2em] font-bold uppercase">Contact Form</span>
                        </a>
                        <a href="/fma_model_entry" class="group block border border-[#d7be53] text-[#d7be53] hover:bg-[#d7be53] hover:text-[#1C110C] py-4 text-center rounded transition-all duration-300 shadow-lg">
                            <span class="block text-[10px] tracking-[0.15em] font-medium opacity-80 mb-0.5">応募フォーム</span>
                            <span class="block text-xs tracking-[0.2em] font-bold uppercase">Entry Form</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script is:inline define:vars={{ castsData: normalizedCastsData }}>
        // 共通データからARTISTを自動抽出（新着順）
        const womanArtists = castsData.filter(m => m.category === 'artist' && m.gender === 'woman').reverse();
        const manArtists = castsData.filter(m => m.category === 'artist' && m.gender === 'man').reverse();

        function renderArtistCards(dataList, containerId) {
            const container = document.getElementById(containerId);
            if (!container) return;

            if (dataList.length === 0) {
                const parentSec = container.closest('div[id^="artist-"]');
                if (parentSec) parentSec.style.display = 'none';
                return;
            }

            dataList.forEach(artist => {
                const card = document.createElement('div');
                card.className = "fade-in-up transition-all duration-300 group cursor-pointer text-center";
                card.innerHTML = `
                    <a href="${artist.link}" class="block">
                        <div style="position: relative; aspect-ratio: 2 / 3;" class="flash-hover aspect-[2/3] w-full bg-[#2A1A14] overflow-hidden relative mb-4 rounded-sm">
                            <img src="${artist.img}" alt="${artist.name}" class="w-full h-full object-cover opacity-90 transition-all duration-1000 group-hover:scale-105 group-hover:opacity-100">
                        </div>
                        <div class="pb-2">
                            <h4 class="font-serif text-sm tracking-[0.2em] text-[#EAE6E1] font-medium uppercase transition-colors group-hover:text-[#d7be53]">${artist.name}</h4>
                            <p class="text-[9px] text-gray-500 tracking-[0.15em] mt-1.5 font-light uppercase">ARTIST</p>
                        </div>
                    </a>
                `;
                container.appendChild(card);
            });
        }

        renderArtistCards(womanArtists, 'artist-woman-grid');
        renderArtistCards(manArtists, 'artist-man-grid');

        setTimeout(() => {
            document.querySelectorAll('.fade-in-up').forEach((card, index) => {
                setTimeout(() => {
                    card.classList.add('is-visible');
                }, index * 80);
            });
        }, 50);
    </script>

</Layout>