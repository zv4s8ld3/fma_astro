---
import Layout from '../layouts/Layout.astro';
import { normalizedCastsData } from '../data/models_data.js';
---

<Layout 
  title="ALL MODELS | Fairy Models Agency"
  description="Fairy Models Agencyに所属する全モデル・アーティストのポートフォリオ一覧。"
>

    <!-- MAIN CONTENT -->
    <main class="max-w-[1400px] mx-auto px-4 sm:px-6 lg:px-8 py-16 md:py-24 w-full flex-grow">
        
        <!-- HEADER TITLE -->
        <div class="text-center mb-10">
            <p class="font-serif text-[#d7be53] text-xs tracking-[0.3em] uppercase mb-2">FAIRY MODELS AGENCY</p>
            <h1 class="font-serif text-3xl md:text-5xl tracking-[0.2em] text-white uppercase font-light">ALL CASTS</h1>
        </div>

        <!-- CATEGORY FILTER TABS -->
        <div class="flex flex-wrap justify-center gap-3 mb-6 text-xs tracking-[0.2em]">
            <button data-category="all" class="filter-tab active border border-[#d7be53]/40 text-[#d7be53] px-6 py-2 rounded transition-all duration-300 hover:border-[#d7be53]">ALL</button>
            <button data-category="woman" class="filter-tab border border-[#d7be53]/40 text-[#d7be53] px-6 py-2 rounded transition-all duration-300 hover:border-[#d7be53]">WOMAN</button>
            <button data-category="man" class="filter-tab border border-[#d7be53]/40 text-[#d7be53] px-6 py-2 rounded transition-all duration-300 hover:border-[#d7be53]">MAN</button>
            <button data-category="artist" class="filter-tab border border-[#d7be53]/40 text-[#d7be53] px-6 py-2 rounded transition-all duration-300 hover:border-[#d7be53]">ARTIST</button>
            <button data-category="direct_booking" class="filter-tab border border-[#d7be53]/40 text-[#d7be53] px-6 py-2 rounded transition-all duration-300 hover:border-[#d7be53]">DIRECT BOOKING</button>
        </div>

        <!-- SORT TABS (ランダム / 新着順 / A-Z順) -->
        <div class="flex flex-wrap justify-center items-center gap-2 mb-14 text-[10px] tracking-[0.2em]">
            <span class="text-gray-500 mr-1 uppercase">SORT :</span>
            <button data-sort="shuffle" class="sort-tab border border-[#d7be53] bg-[#d7be53]/20 text-[#d7be53] px-4 py-1.5 rounded transition-all duration-300 hover:border-[#d7be53]">RANDOM</button>
            <button data-sort="newest" class="sort-tab border border-white/15 text-gray-400 px-4 py-1.5 rounded transition-all duration-300 hover:border-[#d7be53] hover:text-[#d7be53]">NEW ARRIVAL</button>
            <button data-sort="az" class="sort-tab border border-white/15 text-gray-400 px-4 py-1.5 rounded transition-all duration-300 hover:border-[#d7be53] hover:text-[#d7be53]">A - Z</button>
        </div>

        <!-- ALL MODELS GRID (PC: 4列配置) -->
        <div id="all-models-grid" class="grid grid-cols-2 md:grid-cols-4 gap-6 lg:gap-8"></div>

    </main>

    <!-- SECTION: CONTACT -->
    <section id="contact" class="py-24 bg-[#2A1A14] border-t border-white/5 text-[#DDCB82]">
        <div class="max-w-6xl mx-auto px-4">
            <div class="grid grid-cols-1 md:grid-cols-2 gap-12 mb-16">
                <div>
                    <h2 class="font-serif text-3xl text-[#d7be53] mb-8 tracking-[0.15em]">CONTACT</h2>
                    <div class="space-y-4 font-light text-sm tracking-wide text-[#DDCB82]/90">
                        <p class="text-base text-[#d7be53] font-serif">
                            <span class="font-semibold">Fairy Models</span> <span class="font-light">Agency</span>
                        </p>
                        <p class="text-gray-400">Operating by ShopKloset inc.</p>
                        <p class="text-gray-400">MAIL: info@fairymodelsagency.com</p>
                    </div>
                </div>
                
                <div class="flex flex-col justify-center space-y-6">
                    <p class="text-xs text-gray-400 font-light tracking-widest leading-relaxed">
                        出演・キャスティングのご依頼、各種お問い合わせ、モデル応募は下記専用フォームより承っております。
                    </p>
                    <div class="grid grid-cols-1 sm:grid-cols-2 gap-4">
                        <a href="/contact" class="group block bg-[#d7be53] text-[#1C110C] py-4 text-center rounded transition-all duration-300 hover:bg-[#DDCB82] shadow-lg">
                            <span class="block text-[10px] tracking-[0.15em] font-medium opacity-60 mb-0.5">お問い合わせ</span>
                            <span class="block text-xs tracking-[0.2em] font-bold uppercase">Contact Form</span>
                        </a>
                        <a href="/fma_model_entry" class="group block border border-[#d7be53] text-[#d7be53] hover:bg-[#d7be53] hover:text-[#1C110C] py-4 text-center rounded transition-all duration-300 shadow-lg">
                            <span class="block text-[10px] tracking-[0.15em] font-medium opacity-80 mb-0.5">モデル応募</span>
                            <span class="block text-xs tracking-[0.2em] font-bold uppercase">Entry Form</span>
                        </a>
                    </div>
                </div>
            </div>
        </div>
    </section>

    <script is:inline define:vars={{ castsData: normalizedCastsData }}>
        const grid = document.getElementById('all-models-grid');
        let currentCategory = 'all';
        let currentSort = 'shuffle';

        // Fisher-Yates シャッフル関数
        function shuffleArray(array) {
            const arr = [...array];
            for (let i = arr.length - 1; i > 0; i--) {
                const j = Math.floor(Math.random() * (i + 1));
                [arr[i], arr[j]] = [arr[j], arr[i]];
            }
            return arr;
        }

        // キャスト描画処理
        function renderCasts() {
            if (!grid) return;
            grid.innerHTML = '';

            // 1. カテゴリー絞り込み
            let list = currentCategory === 'all'
                ? [...castsData]
                : castsData.filter(item => item.category === currentCategory);

            // 2. 並び替え
            if (currentSort === 'shuffle') {
                list = shuffleArray(list);
            } else if (currentSort === 'newest') {
                list = [...list].reverse();
            } else if (currentSort === 'az') {
                list.sort((a, b) => a.name.localeCompare(b.name, 'en'));
            }

            if (list.length === 0) {
                grid.innerHTML = `<div class="col-span-full text-center py-20 text-gray-500 font-serif tracking-widest text-sm">NO CASTS FOUND</div>`;
                return;
            }

            list.forEach(model => {
                const newBadge = model.isNew
                    ? `<span style="position: absolute; top: 0.625rem; right: 0.625rem; z-index: 20;" class="bg-[#1C110C]/85 border border-[#d7be53] text-[#d7be53] text-[9px] tracking-[0.2em] px-2 py-0.5 rounded-sm font-medium uppercase">NEW</span>`
                    : '';

                const card = document.createElement('div');
                card.className = "fade-in-up transition-all duration-300 group cursor-pointer text-center";
                card.innerHTML = `
                    <a href="${model.link}" class="block">
                        <div style="position: relative; aspect-ratio: 2 / 3;" class="flash-hover aspect-[2/3] w-full bg-[#2A1A14] overflow-hidden relative mb-4 rounded-sm border border-white/5">
                            ${newBadge}
                            <img src="${model.img}" alt="${model.name}" class="w-full h-full object-cover opacity-90 transition-all duration-1000 group-hover:scale-105 group-hover:opacity-100">
                        </div>
                        <div class="pb-2">
                            <h4 class="font-serif text-sm tracking-[0.2em] text-[#EAE6E1] font-medium uppercase transition-colors group-hover:text-[#d7be53]">${model.name}</h4>
                            <p class="text-[9px] text-gray-500 tracking-[0.15em] mt-1.5 font-light">${model.size}</p>
                        </div>
                    </a>
                `;
                grid.appendChild(card);
            });

            setTimeout(() => {
                document.querySelectorAll('.fade-in-up').forEach((el, index) => {
                    setTimeout(() => el.classList.add('is-visible'), index * 50);
                });
            }, 30);
        }

        // カテゴリー切り替えイベント
        document.querySelectorAll('.filter-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                currentCategory = btn.getAttribute('data-category');
                document.querySelectorAll('.filter-tab').forEach(b => b.classList.remove('active'));
                btn.classList.add('active');
                renderCasts();
            });
        });

        // 並び順切り替えイベント
        document.querySelectorAll('.sort-tab').forEach(btn => {
            btn.addEventListener('click', () => {
                currentSort = btn.getAttribute('data-sort');
                document.querySelectorAll('.sort-tab').forEach(b => {
                    b.classList.remove('border-[#d7be53]', 'bg-[#d7be53]/20', 'text-[#d7be53]');
                    b.classList.add('border-white/15', 'text-gray-400');
                });
                btn.classList.remove('border-white/15', 'text-gray-400');
                btn.classList.add('border-[#d7be53]', 'bg-[#d7be53]/20', 'text-[#d7be53]');
                renderCasts();
            });
        });

        // 初回描画
        renderCasts();
    </script>

</Layout>